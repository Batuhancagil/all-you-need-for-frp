generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  participants  Participant[]
  characterSheets CharacterSheet[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum RoomPrivacy {
  PUBLIC
  PRIVATE
}

enum SessionState {
  WAITING
  ACTIVE
  ENDED
}

enum ParticipantRole {
  ADMIN
  GM
  PLAYER
}

enum ChannelType {
  TEXT
  VOICE
  DICE
}

enum RoomType {
  TTRPG
  DOCUMENT
}

model AdminSettings {
  id             String       @id @default("singleton")
  roomNamePrefix String?
  privacy        RoomPrivacy?
  updatedAt      DateTime     @updatedAt
}

model Room {
  id               String        @id @default(cuid())
  name             String
  type             RoomType      @default(TTRPG)
  privacy          RoomPrivacy   @default(PRIVATE)
  inviteCode       String        @unique
  sessionState     SessionState  @default(WAITING)
  recap            String?
  createdAt        DateTime      @default(now())
  sessionStartedAt DateTime?
  sessionEndedAt   DateTime?
  createdByParticipantId String?
  backgroundMusicUrl String?

  gmParticipantId          String?  @unique
  gmParticipant            Participant?   @relation("RoomGm", fields: [gmParticipantId], references: [id], onDelete: SetNull)
  initiativeCurrentEntryId String?  @unique
  initiativeCurrentEntry   InitiativeEntry? @relation("InitiativeCurrentTurn", fields: [initiativeCurrentEntryId], references: [id], onDelete: SetNull)
  initiativeTurnCount      Int      @default(0)
  initiativeRoundCount     Int      @default(0)

  participants       Participant[]
  rolls              Roll[]
  channels           Channel[]
  chatMessages       ChatMessage[]
  initiativeEntries  InitiativeEntry[]
  characterSheets    CharacterSheet[]
  document           RoomDocument?
}

model RoomDocument {
  id        String   @id @default(cuid())
  roomId    String   @unique
  title     String   @default("Untitled")
  yjsState  Bytes?
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Participant {
  id        String          @id @default(cuid())
  roomId    String
  userId    String?
  name      String
  role      ParticipantRole @default(PLAYER)
  joinedAt  DateTime        @default(now())
  lastSeen  DateTime        @default(now())
  inCall    Boolean         @default(false)
  micOn     Boolean         @default(false)
  camOn     Boolean         @default(false)
  callChannelSlug String?

  room             Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  rolls            Roll[]
  chatMessages     ChatMessage[]
  initiativeEntries InitiativeEntry[]
  characterSheet   CharacterSheet?

  gmRoom Room? @relation("RoomGm")

  @@index([roomId, userId])
}

model Roll {
  id               String   @id @default(cuid())
  roomId           String
  participantId    String
  participantName  String
  rollName         String?
  sides            Int      @default(20)
  count            Int      @default(1)
  expression       String?
  modifier         Int      @default(0)
  results          Int[]
  total            Int
  createdAt        DateTime @default(now())

  room        Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Channel {
  id        String      @id @default(cuid())
  roomId    String
  name      String
  slug      String
  type      ChannelType
  createdAt DateTime    @default(now())

  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  chatMessages ChatMessage[]

  @@unique([roomId, slug, type])
  @@index([roomId, type])
}

model ChatMessage {
  id            String   @id @default(cuid())
  roomId        String
  channelId     String
  participantId String
  content       String?
  imageDataUrl  String?
  createdAt     DateTime @default(now())

  room        Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  channel     Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([roomId, channelId, createdAt])
}

model InitiativeEntry {
  id             String   @id @default(cuid())
  roomId         String
  participantId  String?
  creatureName   String?
  expression     String
  result         Int
  results        Int[]    @default([])
  sortOrder      Int
  isAlive        Boolean  @default(true)
  createdAt      DateTime @default(now())

  room              Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participant       Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  currentTurnRoom   Room?       @relation("InitiativeCurrentTurn")

  @@index([roomId])
}

model CharacterSheet {
  id            String   @id @default(cuid())
  roomId        String
  userId        String
  participantId String?  @unique
  data          Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([roomId, userId])
  @@index([roomId])
}
